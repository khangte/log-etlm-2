    {
      "type": "timeseries",
      "title": "분당 주문 수·매출",
      "description": "1분 집계. 막대는 주문 수, 선은 매출(오른쪽 축). 주황은 진행 중인 미완료 구간이다.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT t,\n  if(t < toStartOfMinute(now64(3)), n, NULL) AS `주문 수`, if(t >= toStartOfMinute(now64(3)), n, NULL) AS `주문 수(진행 중)`,\n  if(t < toStartOfMinute(now64(3)), r, NULL) AS `매출`, if(t >= toStartOfMinute(now64(3)), r, NULL) AS `매출(진행 중)`\nFROM (SELECT toStartOfMinute(event_timestamp) AS t, count() AS n, sum(total_amount) AS r FROM gold.orders_deduplicated WHERE $__timeFilter(event_timestamp) GROUP BY t)\nORDER BY t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
