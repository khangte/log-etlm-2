  "refresh": "1m",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "주문 요약",
      "description": "조회 범위 전체(진행 중인 분 포함). 중복 제거 뷰(FINAL) 기준. 매출은 할인 적용 후 주문 완료 금액이며 순매출이 아니다. 이 패널의 쿼리(차원별 집계)를 차원 패널들이 재사용한다.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT category, region, payment_method, user_tier,\n  count() AS n, sum(total_amount) AS revenue, sum(quantity) AS qty, sum(discount_amount) AS discount\nFROM gold.orders_deduplicated WHERE $__timeFilter(event_timestamp)\nGROUP BY category, region, payment_method, user_tier"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "측정 불가"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "주문 매출"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyKRW"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "평균 주문 금액"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyKRW"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "할인 금액"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyKRW"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "reduceFields",
            "reducers": [
              "sum"
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "avg",
            "replaceFields": false,
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "revenue"
                }
              },
              "operator": "/",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "n"
                }
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "category": true,
              "region": true,
              "payment_method": true,
              "user_tier": true
            },
            "indexByName": {
              "n": 0,
              "revenue": 1,
              "avg": 2,
              "qty": 3,
              "discount": 4
            },
            "renameByName": {
              "n": "주문 수",
              "revenue": "주문 매출",
              "avg": "평균 주문 금액",
              "qty": "판매 수량",
              "discount": "할인 금액"
            }
          }
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 13,
        "h": 5
      }
