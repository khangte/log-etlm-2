    {
      "type": "stat",
      "title": "데이터 최신성",
      "description": "ClickHouse 현재 시각 − 범위 내 최신 event_timestamp. FINAL 없는 뷰로 계산한다(중복 제거와 무관하게 최댓값은 같다). WSL 시계 보정으로 1초 미만 흔들림은 지연 변화로 해석하지 않는다.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT if(count() = 0, NULL, dateDiff('millisecond', max(event_timestamp), now64(3)) / 1000) AS `데이터 최신성`\nFROM gold.order_event_latency WHERE $__timeFilter(event_timestamp)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "측정 불가"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "데이터 최신성"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "noValue",
                "value": "데이터 없음"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
