    {
      "type": "timeseries",
      "title": "이벤트 단위 지연(정상 주문, 5초 구간)",
      "description": "gold.order_event_latency(이벤트 단위, 재처리 시도 행 포함). 생성→Kafka = LogAppendTime − event_timestamp, Kafka→Spark = 콜백 진입 − LogAppendTime(트리거 준비 시간 포함). 이벤트 시각 5초 구간. 두 구간을 합산하지 않는다.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT t,\n  ga AS `생성→Kafka 평균`, gq[1] AS `생성→Kafka p50`, gq[2] AS `생성→Kafka p95`, gq[3] AS `생성→Kafka p99`,\n  sa AS `Kafka→Spark 평균`, sq[1] AS `Kafka→Spark p50`, sq[2] AS `Kafka→Spark p95`, sq[3] AS `Kafka→Spark p99`,\n  n AS `측정 건수`\nFROM (\nSELECT toStartOfInterval(event_timestamp, INTERVAL 5 SECOND) AS t, avg(g) AS ga, quantilesExact(0.5, 0.95, 0.99)(g) AS gq,\n  avg(s) AS sa, quantilesExact(0.5, 0.95, 0.99)(s) AS sq, count() AS n\nFROM (\n  SELECT event_timestamp,\n    dateDiff('millisecond', event_timestamp, kafka_append_timestamp) AS g,\n    dateDiff('millisecond', kafka_append_timestamp, spark_processed_at) AS s\n  FROM gold.order_event_latency WHERE $__timeFilter(event_timestamp)\n)\nGROUP BY t\n) ORDER BY t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineWidth": 1
