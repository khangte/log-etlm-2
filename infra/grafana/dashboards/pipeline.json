    {
      "type": "stat",
      "title": "데이터 최신성·Spark 재시작",
      "description": "최신성 = ClickHouse 현재 시각 − 범위 내 최신 event_timestamp(FINAL 없이 계산해도 최댓값은 같다). 데이터 없으면 '데이터 없음'. 재시작 = 같은 query_id의 run_id 수 − 1.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  (SELECT if(count() = 0, NULL, dateDiff('millisecond', max(event_timestamp), now64(3)) / 1000)\n   FROM gold.order_event_latency WHERE $__timeFilter(event_timestamp)) AS `데이터 최신성`,\n  (SELECT if(count() = 0, NULL, toInt64(max(c)) - 1)\n   FROM (SELECT query_id, uniqExact(run_id) AS c FROM ops.spark_query_progress\n         WHERE $__timeFilter(trigger_at) GROUP BY query_id)) AS `Spark 재시작 횟수`"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "측정 불가"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "데이터 최신성"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "noValue",
                "value": "데이터 없음"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
