    {
      "type": "table",
      "title": "실패 시도(실패 단계별)",
      "description": "ops.spark_batch_attempts의 실패 시도. 실패 시도의 action 시간은 측정하지 못해 0이므로 시간 패널에서 뺐다.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT failed_stage AS `실패 단계`, count() AS `시도 수`, max(callback_started_at) AS `마지막 실패`\nFROM ops.spark_batch_attempts\nWHERE $__timeFilter(callback_started_at) AND status != 'succeeded'\nGROUP BY failed_stage ORDER BY `시도 수` DESC"
        }
      ],
