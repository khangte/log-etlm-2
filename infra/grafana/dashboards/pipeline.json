          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT toStartOfSecond(interval_start) AS t, sum(acked) AS `ACK`, sum(generated) AS `생성`, sum(target_eps) AS `목표`\nFROM ops.producer_stats WHERE $__timeFilter(interval_start) GROUP BY t ORDER BY t"
