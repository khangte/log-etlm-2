          "rawSql": "SELECT toStartOfInterval(event_time, INTERVAL 5 SECOND) AS t,\n  quantileExact(0.5)(query_duration_ms) AS p50, quantileExact(0.95)(query_duration_ms) AS p95,\n  max(query_duration_ms) AS `최대`, count() AS `쿼리 수`\nFROM system.query_log\nWHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime) AND $__timeFilter(event_time) AND user = 'grafana_reader' AND type = 'QueryFinish'\nGROUP BY t ORDER BY t"
