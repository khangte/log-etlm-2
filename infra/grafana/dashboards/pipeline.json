          "format": 0,
          "rawSql": "SELECT trigger_at AS t, concat('p', toString(p)) AS partition,\n  if(empty(latest_offsets), NULL, latest_offsets[p] - end_offsets[p]) AS backlog\nFROM ops.spark_query_progress\nARRAY JOIN mapKeys(if(empty(latest_offsets), end_offsets, latest_offsets)) AS p\nWHERE $__timeFilter(trigger_at) ORDER BY t"
