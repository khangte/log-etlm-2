# 공통 환경변수 템플릿
# 사용법: cp .env.example .env 후 값을 수정한다. 실제 .env는 Git에서 제외된다.
# Python 앱: `uv run log-generator` 실행 시 루트 .env를 읽는다. 이 파일은 실행 시 읽지 않는다.
# .env가 없으면 환경변수만 사용한다(컨테이너는 Compose가 주입).
# Compose: 루트 .env를 자동으로 읽는다. 컨테이너 전달 변수는 compose.yaml에 명시한다.
# 이 파일은 실행 환경(로컬·도커·테스트)별로 달라지는 외부 설정값의 예시다.
# 코드는 apps/log_generator/src/log_generator/config.py가 읽어 타입 변환·검증을 적용한다. 코드 기본값은 없다.
# 모든 키를 명시한다. 누락·필수값 공백은 오류이며 seed·stdout 경로·부하 프로파일만 빈 값을 허용한다.
# 환경변수가 .env보다 우선한다. 일회성 변경: `PRODUCER_EPS=1000 uv run log-generator`.
# 개인정보·비밀값은 이 파일에 기록하지 않는다.

# ---------------------------------------------------------------
# 1단계: 로그 생성기 (apps/log_generator)
# ---------------------------------------------------------------

# 목표 처리량(EPS). 정상·health_check·불량 로그 합계 기준, 양의 정수
PRODUCER_EPS=5000

# 출력 대상: stdout | file | kafka
PRODUCER_OUTPUT=kafka

# file 출력 경로. PRODUCER_OUTPUT=file일 때 필수, 기존 파일이 있으면 오류로 종료
# 상대 경로는 실행 디렉터리(apps/log_generator) 기준
PRODUCER_OUTPUT_PATH=

# 최대 생성 건수. 0 이상 정수, 0은 무제한(Ctrl+C로 종료). 기본 300000은 5000 EPS에서 약 60초
PRODUCER_MAX_EVENTS=300000

# 합성 사용자 풀 크기. 양의 정수, usr_00001부터 생성
PRODUCER_USER_POOL_SIZE=500

# 무작위 선택 재현용 seed. 비우면 미지정(매 실행 다른 선택)
PRODUCER_SEED=

# stderr 상태 출력 주기(초). 양의 정수
PRODUCER_STATUS_INTERVAL_SEC=1

# 시간대별 부하 프로파일 CSV(duration_sec,eps,label). 비우면 PRODUCER_EPS 고정 속도
# 지정하면 PRODUCER_EPS 대신 구간별 EPS를 쓰고 마지막 구간이 끝나면 종료한다. 측정 시 PRODUCER_MAX_EVENTS=0
# 상대 경로는 프로젝트 루트 기준. 예: apps/log_generator/profiles/daily.csv(60분), spike-12k.csv·spike-10k.csv(15분)
PRODUCER_LOAD_PROFILE=

# Kafka Producer 설정. PRODUCER_OUTPUT=kafka일 때만 사용하지만 키는 모두 명시해야 한다.
# acks=all·idempotence·statistics.interval.ms=1000은 코드에 고정되어 있다.
# WSL 호스트에서 접속하는 주소. KAFKA_HOST_PORT와 일치시킨다.
PRODUCER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# 배치를 모으는 대기 시간(ms). 0 이상 정수
PRODUCER_KAFKA_LINGER_MS=5
# 압축: none | gzip | snappy | lz4 | zstd
PRODUCER_KAFKA_COMPRESSION=lz4
# 전송 최종 실패까지의 제한(ms). 양의 정수
PRODUCER_KAFKA_DELIVERY_TIMEOUT_MS=30000
# 로컬 큐가 가득 찼을 때 poll하며 기다리는 최대 시간(초). 초과하면 비정상 종료. 양의 정수
PRODUCER_KAFKA_QUEUE_FULL_TIMEOUT_SEC=30
# 종료 시 flush 최대 대기 시간(초). 양의 정수
PRODUCER_KAFKA_FLUSH_TIMEOUT_SEC=30

# ---------------------------------------------------------------
# 2단계: Kafka 로컬 실행 (Compose)
# ---------------------------------------------------------------

# WSL 호스트 공개 포트. 내부 서비스는 kafka:19092를 사용한다.
KAFKA_HOST_PORT=9092

# 초기화할 원본 로그 토픽. 기존 토픽의 설정은 자동 변경하지 않는다.
KAFKA_TOPIC=raw.ecommerce.orders.v1
# 생성기가 전송할 원본 토픽. KAFKA_TOPIC을 참조해 이름이 어긋나지 않게 한다.
# dotenv는 위에 정의된 변수만 펼치므로 KAFKA_TOPIC보다 아래에 둔다.
PRODUCER_KAFKA_TOPIC=${KAFKA_TOPIC}

# 초기화할 DLQ 토픽. 기록은 3단계에서 구현한다.
KAFKA_DLQ_TOPIC=dlq.ecommerce.orders.v1

# Kafka UI 호스트 포트(루프백 게시). 충돌 시 이 값만 변경한다.
KAFKA_UI_HOST_PORT=8080

# ---------------------------------------------------------------
# 3단계: Spark 스트림 처리 (apps/streaming, Compose spark 서비스)
# ---------------------------------------------------------------
# 컨테이너 안에서만 읽는다. apps/streaming/src/streaming/config.py가 기본값 없이 검증한다.
# 원본·DLQ 토픽은 위 KAFKA_TOPIC·KAFKA_DLQ_TOPIC을 사용한다. 값의 근거는 docs/prd/03-stream-processing.md.
# JDBC 배치 크기·쓰기 병렬도와 ClickHouse 접속은 아래 4단계 절에 있다.

# local 모드 태스크 수. 원본 파티션 3개와 1:1
SPARK_MASTER=local[3]
# driver heap(local 모드 실행 메모리 전체). 컨테이너 mem_limit 3g 안에서 Python worker와 나눠 쓴다.
SPARK_DRIVER_MEMORY=2g
# 마이크로배치 트리거 주기(Spark processingTime 문자열)
SPARK_TRIGGER_INTERVAL=5 seconds
# 배치당 최대 offset 수. 양의 정수. 없으면 earliest 첫 배치가 보관분 전체를 읽는다.
SPARK_MAX_OFFSETS_PER_TRIGGER=50000
# 배치 내 dropDuplicates 셔플 파티션 수. 양의 정수
SPARK_SHUFFLE_PARTITIONS=3
# 체크포인트 경로. spark-checkpoints 볼륨 안이며 Git 밖에 있다.
SPARK_CHECKPOINT_DIR=/opt/spark/checkpoints/orders
# 지연 분위수 집계 여부: true | false. false면 건수만 집계한다(계측 오버헤드 대조군 전용). 없으면 Compose가 true로 둔다.
SPARK_LATENCY_METRICS_ENABLED=true
# 진행·유휴 이벤트가 이 시간(초) 동안 없으면 멈춤으로 보고 exit 1. Compose가 재시작한다.
SPARK_STALL_TIMEOUT_SECONDS=90
# 최초 실행 시작 위치: earliest | latest. 재시작은 체크포인트 위치가 우선한다.
SPARK_STARTING_OFFSETS=earliest
# Compose 내부 브로커 주소
SPARK_KAFKA_BOOTSTRAP_SERVERS=kafka:19092

# ---------------------------------------------------------------
# 4단계: ClickHouse 적재 (Compose clickhouse·clickhouse-init 서비스, Spark JDBC)
# ---------------------------------------------------------------
# 근거: docs/prd/04-clickhouse-storage.md '실행 구성'. 비밀번호는 이 파일에 적지 않고 .env에만 설정한다.

# ClickHouse HTTP 호스트 포트(루프백 게시). 생성기 지표 INSERT와 수동 점검용
CLICKHOUSE_HTTP_HOST_PORT=8123
# 관리자 계정(clickhouse-init과 수동 점검 전용)
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=
# 생성기 ops.producer_stats 기록 주소(WSL 호스트). CLICKHOUSE_HTTP_HOST_PORT와 일치시킨다.
# 비우면 기록하지 않는다. kafka 출력일 때만 사용하며 값이 있으면 CLICKHOUSE_GENERATOR_PASSWORD가 필요하다.
PRODUCER_CLICKHOUSE_HTTP_URL=http://localhost:8123
# 서비스별 계정 비밀번호. 계정 이름은 init.sh에 고정(spark_writer, generator_writer, grafana_reader, monitor_writer)
CLICKHOUSE_SPARK_PASSWORD=
CLICKHOUSE_GENERATOR_PASSWORD=
CLICKHOUSE_GRAFANA_PASSWORD=
CLICKHOUSE_MONITOR_PASSWORD=
# host-monitor 멈춤 판정 임계값(ms). 1초 틱 간격이 이 값 이상이면 ops.host_stalls에 기록한다.
HOST_STALL_THRESHOLD_MS=2000
# Spark JDBC URL. 동기 INSERT를 서버 설정으로 명시한다.
SPARK_CLICKHOUSE_JDBC_URL=jdbc:clickhouse:http://clickhouse:8123?clickhouse_setting_async_insert=0
# Spark 드라이버의 운영 지표 HTTP INSERT 주소(Compose 내부)
SPARK_CLICKHOUSE_HTTP_URL=http://clickhouse:8123
# JDBC batchsize. SPARK_MAX_OFFSETS_PER_TRIGGER와 같게 두어 쓰기 파티션당 INSERT 1회를 보장한다.
SPARK_JDBC_BATCH_SIZE=50000
# JDBC 쓰기 파티션 수(동시 연결 수). SPARK_SHUFFLE_PARTITIONS와 같게 둔다.
SPARK_JDBC_NUM_PARTITIONS=3

# ---------------------------------------------------------------
# 5단계: Grafana 시각화 (Compose grafana 서비스)
# ---------------------------------------------------------------
# 근거: docs/prd/05-grafana-dashboard.md '실행 구성'. 데이터 소스는 위 CLICKHOUSE_GRAFANA_PASSWORD를 쓴다.

# Grafana 호스트 포트(루프백 게시)
GRAFANA_HOST_PORT=3000
# Grafana 관리자 계정. 비밀번호는 .env에만 설정한다.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
