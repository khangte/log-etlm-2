# 공통 환경변수 템플릿
# 사용법: cp .env.example .env 후 값을 수정한다. 실제 .env는 Git에서 제외된다.
# Python 앱: `uv run log-generator` 실행 시 루트 .env를 읽는다. 이 파일은 실행 시 읽지 않는다.
# .env가 없으면 환경변수만 사용한다(컨테이너는 Compose가 주입).
# Compose: 루트 .env를 자동으로 읽는다. 컨테이너 전달 변수는 compose.yaml에 명시한다.
# 이 파일은 실행 환경(로컬·도커·테스트)별로 달라지는 외부 설정값의 예시다.
# 코드는 apps/log_generator/src/log_generator/config.py가 읽어 타입 변환·검증을 적용한다. 코드 기본값은 없다.
# 모든 키를 명시한다. 누락·필수값 공백은 오류이며 seed·stdout 경로만 빈 값을 허용한다.
# 환경변수가 .env보다 우선한다. 일회성 변경: `PRODUCER_EPS=1000 uv run log-generator`.
# 개인정보·비밀값은 이 파일에 기록하지 않는다.

# ---------------------------------------------------------------
# 1단계: 로그 생성기 (apps/log_generator)
# ---------------------------------------------------------------

# 목표 처리량(EPS). 정상·health_check·불량 로그 합계 기준, 양의 정수
PRODUCER_EPS=5000

# 출력 대상: stdout | file | kafka
PRODUCER_OUTPUT=kafka

# file 출력 경로. PRODUCER_OUTPUT=file일 때 필수, 기존 파일이 있으면 오류로 종료
# 상대 경로는 실행 디렉터리(apps/log_generator) 기준
PRODUCER_OUTPUT_PATH=

# 최대 생성 건수. 0 이상 정수, 0은 무제한(Ctrl+C로 종료). 기본 300000은 5000 EPS에서 약 60초
PRODUCER_MAX_EVENTS=300000

# 합성 사용자 풀 크기. 양의 정수, usr_00001부터 생성
PRODUCER_USER_POOL_SIZE=500

# 무작위 선택 재현용 seed. 비우면 미지정(매 실행 다른 선택)
PRODUCER_SEED=

# stderr 상태 출력 주기(초). 양의 정수
PRODUCER_STATUS_INTERVAL_SEC=1

# Kafka Producer 설정. PRODUCER_OUTPUT=kafka일 때만 사용하지만 키는 모두 명시해야 한다.
# acks=all·idempotence·statistics.interval.ms=1000은 코드에 고정되어 있다.
# WSL 호스트에서 접속하는 주소. KAFKA_HOST_PORT와 일치시킨다.
PRODUCER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# 배치를 모으는 대기 시간(ms). 0 이상 정수
PRODUCER_KAFKA_LINGER_MS=5
# 압축: none | gzip | snappy | lz4 | zstd
PRODUCER_KAFKA_COMPRESSION=lz4
# 전송 최종 실패까지의 제한(ms). 양의 정수
PRODUCER_KAFKA_DELIVERY_TIMEOUT_MS=30000
# 로컬 큐가 가득 찼을 때 poll하며 기다리는 최대 시간(초). 초과하면 비정상 종료. 양의 정수
PRODUCER_KAFKA_QUEUE_FULL_TIMEOUT_SEC=30
# 종료 시 flush 최대 대기 시간(초). 양의 정수
PRODUCER_KAFKA_FLUSH_TIMEOUT_SEC=30

# ---------------------------------------------------------------
# 2단계: Kafka 로컬 실행 (Compose)
# ---------------------------------------------------------------

# WSL 호스트 공개 포트. 내부 서비스는 kafka:19092를 사용한다.
KAFKA_HOST_PORT=9092

# 초기화할 원본 로그 토픽. 기존 토픽의 설정은 자동 변경하지 않는다.
KAFKA_TOPIC=raw.ecommerce.orders.v1
# 생성기가 전송할 원본 토픽. KAFKA_TOPIC을 참조해 이름이 어긋나지 않게 한다.
# dotenv는 위에 정의된 변수만 펼치므로 KAFKA_TOPIC보다 아래에 둔다.
PRODUCER_KAFKA_TOPIC=${KAFKA_TOPIC}

# 초기화할 DLQ 토픽. 기록은 3단계에서 구현한다.
KAFKA_DLQ_TOPIC=dlq.ecommerce.orders.v1

# Kafka UI 호스트 포트(루프백 게시). 충돌 시 이 값만 변경한다.
KAFKA_UI_HOST_PORT=8080
